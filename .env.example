# --- Учётные данные для postgres / minio ---
POSTGRES_USER=gophkeeper
POSTGRES_PASSWORD=gophkeeper
POSTGRES_DB=gophkeeper

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- gRPC  ---
GOPHKEEPER_GRPC_PUBLISH=50051
GOPHKEEPER_GRPC_ADDR=0.0.0.0:50051
GOPHKEEPER_GRPC_TLS_CERT_PATH=certs/server.crt
GOPHKEEPER_GRPC_TLS_KEY_PATH=certs/server.key

# debug | info | warn | error
GOPHKEEPER_LOG_LEVEL=info

GOPHKEEPER_MINIO_BUCKET=gophkeeper
GOPHKEEPER_MINIO_USE_SSL=false

GOPHKEEPER_DATABASE_URL=postgres://gophkeeper:gophkeeper@127.0.0.1:5432/gophkeeper?sslmode=disable
GOPHKEEPER_MINIO_ENDPOINT=127.0.0.1:9000
GOPHKEEPER_MINIO_ACCESS_KEY=minioadmin
GOPHKEEPER_MINIO_SECRET_KEY=minioadmin

GOPHKEEPER_JWT_SECRET=replace-with-strong-random-secret-min-32-chars-long
GOPHKEEPER_ACCESS_TOKEN_TTL_SECONDS=900
GOPHKEEPER_REFRESH_TOKEN_TTL_SECONDS=2592000

# Vault/blob limits
GOPHKEEPER_INLINE_THRESHOLD_BYTES=262144
GOPHKEEPER_MAX_BLOB_SIZE_BYTES=104857600
GOPHKEEPER_MAX_CHUNK_SIZE_BYTES=8388608
GOPHKEEPER_GRPC_MAX_MESSAGE_BYTES=104857600

# Upload session lifetime in hours (used by StartBlobUpload / expiry checks).
GOPHKEEPER_UPLOAD_SESSION_TTL_HOURS=24

# Interval for background removal of expired blob upload sessions (0 = disabled).
GOPHKEEPER_UPLOAD_SESSION_CLEANUP_INTERVAL_MINUTES=15
